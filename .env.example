# ==========================================
# Varad Engineering - Email Configuration (Resend)
# ==========================================

# 1. Sign up at https://resend.com and grab your API Key (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# 2. Email address where customer enquiries should be sent (your company inbox)
CONTACT_RECEIVER_EMAIL=info@varadengg.com

# 3. From email address
# Note: Before verifying your custom domain on Resend, you can use:
# onboarding@resend.dev (Resend only allows sending to your account email in free unverified mode)
# Once you verify varadengg.com on Resend, use:
# Varad Engineering <enquiry@varadengg.com>
CONTACT_FROM_EMAIL=Varad Engineering <onboarding@resend.dev>
